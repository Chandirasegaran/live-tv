<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while a channel is tuning: the app's line TV with an arc that spins and breathes around it. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="96dp"
            android:height="96dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <!-- the app's line TV (drawable/ic_glyph.xml), scaled into the ring -->
            <group
                android:scaleX="0.33"
                android:scaleY="0.33"
                android:translateX="6.2"
                android:translateY="6.2">
                <path
                    android:pathData="M32.1,38.1 H75.9 A7.5,7.5 0 0 1 83.4,45.6 V68.5 A7.5,7.5 0 0 1 75.9,76 H32.1 A7.5,7.5 0 0 1 24.6,68.5 V45.6 A7.5,7.5 0 0 1 32.1,38.1 Z M38.4,24.8 L51.6,38.1 M69.4,24.8 L56.1,38.1 M37.6,78.6 L32.7,83.4 M70.4,78.6 L75.3,83.4"
                    android:strokeWidth="4.2"
                    android:strokeColor="#A8FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>
            <group
                android:name="spin"
                android:pivotX="24"
                android:pivotY="24">
                <path
                    android:name="arc"
                    android:pathData="M24,3 A21,21 0 1 1 23.99,3"
                    android:strokeWidth="2.4"
                    android:strokeColor="#EBFFFFFF"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0.1" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="360" />
        </aapt:attr>
    </target>
    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="750"
                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="trimPathEnd"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0.08"
                android:valueTo="0.6"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
