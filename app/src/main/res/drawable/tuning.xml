<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while a channel is tuning: the app's line TV with an arc that spins and breathes around it. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="96dp"
            android:height="96dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <!-- the app's line TV (drawable/ic_glyph.xml), scaled into the ring -->
            <group
                android:scaleX="0.33"
                android:scaleY="0.33"
                android:translateX="6.2"
                android:translateY="6.2">
                <path
                    android:pathData="M29.8,35 H78.2 A4,4 0 0 1 82.2,39 V77.5 A4,4 0 0 1 78.2,81.5 H29.8 A4,4 0 0 1 25.8,77.5 V39 A4,4 0 0 1 29.8,35 Z M36.7,41.3 H71.6 A4,4 0 0 1 75.6,45.3 V71.5 A4,4 0 0 1 71.6,75.5 H36.7 A4,4 0 0 1 32.7,71.5 V45.3 A4,4 0 0 1 36.7,41.3 Z M50.1,21.8 L63.6,35 L76.8,21.8 M34.8,81.8 L32.4,86 M72,81.8 L75.6,86"
                    android:strokeWidth="3.4"
                    android:strokeColor="#A8FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>
            <group
                android:name="spin"
                android:pivotX="24"
                android:pivotY="24">
                <path
                    android:name="arc"
                    android:pathData="M24,3 A21,21 0 1 1 23.99,3"
                    android:strokeWidth="2.4"
                    android:strokeColor="#EBFFFFFF"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0.1" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1100"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="360" />
        </aapt:attr>
    </target>
    <target android:name="arc">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="750"
                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="trimPathEnd"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="0.08"
                android:valueTo="0.6"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
